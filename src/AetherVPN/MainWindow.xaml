<Window x:Class="AetherVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:AetherVPN.Converters"
        xmlns:vm="clr-namespace:AetherVPN.ViewModels"
        mc:Ignorable="d"
        Title="AetherVPN" 
        Height="720" Width="440"
        MinHeight="600" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        ResizeMode="CanResizeWithGrip"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:StatusToColorConverter x:Key="StatusToColor" />
        <converters:StatusToBoolConverter x:Key="StatusToBool" />
        <converters:InverseBoolConverter x:Key="InverseBool" />

        <!-- Rounded Button Style -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="25"
                                Padding="24,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Link Button -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,24">

                <!-- ===== HEADER ===== -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,20">
                    <TextBlock Text="⚡" FontSize="28" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="AetherVPN" FontSize="26" FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- ===== STATUS INDICATOR ===== -->
                <Border Background="{StaticResource BgMediumBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Status Circle -->
                        <Ellipse Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,12"
                                 Fill="{Binding Status, Converter={StaticResource StatusToColor}}"
                                 Opacity="0.9">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#00B894"
                                                  BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Status Text -->
                        <TextBlock Text="{Binding StatusText}" 
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />

                        <!-- Duration -->
                        <TextBlock Text="{Binding ConnectionDuration}"
                                   FontSize="22" FontWeight="Light" FontFamily="Consolas"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />

                        <!-- Exit IP -->
                        <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Visibility="{Binding ExitIp, TargetNullValue=Collapsed, FallbackValue=Collapsed}">
                            <Run Text="Exit IP: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <Run Text="{Binding ExitIp, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                        </TextBlock>

                        <!-- Device Info -->
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0"
                                   Visibility="{Binding AssignedIpv4, TargetNullValue=Collapsed, FallbackValue=Collapsed}">
                            <Run Text="Assigned: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                            <Run Text="{Binding AssignedIpv4, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                        </TextBlock>

                        <!-- Connect/Disconnect Button -->
                        <Grid Margin="0,16,0,0" HorizontalAlignment="Center">
                            <!-- Connect Button -->
                            <Button Style="{StaticResource RoundedButton}"
                                    Background="{StaticResource AccentBrush}"
                                    Content="🔗  Connect"
                                    Command="{Binding ConnectCommand}"
                                    Width="200" Height="50"
                                    Visibility="{Binding CanConnect, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <!-- Disconnect Button -->
                            <Button Style="{StaticResource RoundedButton}"
                                    Background="{StaticResource DangerBrush}"
                                    Content="⛓️‍💥  Disconnect"
                                    Command="{Binding DisconnectCommand}"
                                    Width="200" Height="50"
                                    Visibility="{Binding CanDisconnect, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== BASIC SETTINGS ===== -->
                <Border Background="{StaticResource BgMediumBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CONNECTION SETTINGS" Style="{StaticResource SectionLabel}" />

                        <!-- Protocol -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Protocol" Foreground="{StaticResource TextPrimaryBrush}" 
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                      SelectedValue="{Binding SelectedProtocol}"
                                      SelectedValuePath="Tag"
                                      IsEnabled="{Binding CanConnect}">
                                <ComboBoxItem Content="MASQUE (Recommended)" Tag="masque" />
                                <ComboBoxItem Content="WireGuard" Tag="wg" />
                                <ComboBoxItem Content="Gool (Double WG)" Tag="gool" />
                                <ComboBoxItem Content="MasqueInMasque" Tag="mim" />
                            </ComboBox>
                        </Grid>

                        <!-- Scan Mode -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Scan Mode" Foreground="{StaticResource TextPrimaryBrush}" 
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                      SelectedValue="{Binding SelectedScanMode}"
                                      SelectedValuePath="Tag"
                                      IsEnabled="{Binding CanConnect}">
                                <ComboBoxItem Content="Balanced" Tag="balanced" />
                                <ComboBoxItem Content="Quick" Tag="quick" />
                                <ComboBoxItem Content="Turbo" Tag="turbo" />
                                <ComboBoxItem Content="Full Scan" Tag="full" />
                            </ComboBox>
                        </Grid>

                        <!-- IP Version -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="IP Version" Foreground="{StaticResource TextPrimaryBrush}" 
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                      SelectedValue="{Binding SelectedIpVersion}"
                                      SelectedValuePath="Tag"
                                      IsEnabled="{Binding CanConnect}">
                                <ComboBoxItem Content="IPv4" Tag="4" />
                                <ComboBoxItem Content="IPv6" Tag="6" />
                                <ComboBoxItem Content="Both (v4 + v6)" Tag="46" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== TOGGLES ===== -->
                <Border Background="{StaticResource BgMediumBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- System Proxy Toggle -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="System Proxy" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                <TextBlock Text="Auto-configure Windows proxy" 
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding EnableSystemProxy}" 
                                      VerticalAlignment="Center" IsEnabled="{Binding CanConnect}" />
                        </Grid>

                        <!-- Auto Reconnect Toggle -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Auto Reconnect" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                <TextBlock Text="Automatically reconnect on disconnect" 
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding AutoReconnect}" 
                                      VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== ADVANCED SETTINGS ===== -->
                <Button Style="{StaticResource LinkButton}" 
                        Command="{Binding ToggleAdvancedSettingsCommand}"
                        HorizontalAlignment="Left" Margin="4,0,0,8">
                    <TextBlock Text="▶ Advanced Settings" Foreground="{StaticResource PrimaryBrush}" FontSize="12" />
                </Button>

                <Border Background="{StaticResource BgMediumBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12"
                        Visibility="{Binding ShowAdvancedSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="ADVANCED" Style="{StaticResource SectionLabel}" />

                        <!-- SOCKS Port -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SOCKS Port" Foreground="{StaticResource TextPrimaryBrush}" 
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Column="1" Text="{Binding SocksPort}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Background="{StaticResource BgLightBrush}"
                                     BorderBrush="{StaticResource BgLightBrush}"
                                     Padding="8,6" FontSize="13"
                                     IsEnabled="{Binding CanConnect}" />
                        </Grid>

                        <!-- Obfuscation -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Obfuscation" Foreground="{StaticResource TextPrimaryBrush}" 
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                      SelectedValue="{Binding SelectedNoizeProfile}"
                                      SelectedValuePath="Tag"
                                      IsEnabled="{Binding CanConnect}">
                                <ComboBoxItem Content="Off" Tag="off" />
                                <ComboBoxItem Content="Firewall" Tag="firewall" />
                                <ComboBoxItem Content="Balanced" Tag="balanced" />
                                <ComboBoxItem Content="Heavy" Tag="heavy" />
                            </ComboBox>
                        </Grid>

                        <!-- HTTP/2 Mode -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HTTP/2 Mode (for MASQUE)" Foreground="{StaticResource TextPrimaryBrush}" 
                                       FontSize="13" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding UseHttp2}" 
                                      VerticalAlignment="Center" IsEnabled="{Binding CanConnect}" />
                        </Grid>

                        <!-- TLS Fragment -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TLS Fragmentation" Foreground="{StaticResource TextPrimaryBrush}" 
                                       FontSize="13" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding UseFragment}" 
                                      VerticalAlignment="Center" IsEnabled="{Binding CanConnect}" />
                        </Grid>

                        <!-- Upstream Proxy -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Upstream Proxy" Foreground="{StaticResource TextPrimaryBrush}" 
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Column="1" Text="{Binding UpstreamProxy}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Background="{StaticResource BgLightBrush}"
                                     BorderBrush="{StaticResource BgLightBrush}"
                                     Padding="8,6" FontSize="13"
                                     IsEnabled="{Binding CanConnect}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== LOG VIEWER ===== -->
                <Border Background="{StaticResource BgMediumBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="LOGS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource LinkButton}" Content="Save" 
                                        Command="{Binding SaveLogsCommand}" Margin="0,0,12,0" />
                                <Button Style="{StaticResource LinkButton}" Content="Clear" 
                                        Command="{Binding ClearLogsCommand}" />
                            </StackPanel>
                        </Grid>

                        <TextBox Text="{Binding LogText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxHeight="200" MinHeight="120"
                                 FontFamily="Consolas" FontSize="11"
                                 Foreground="#A8D8A8"
                                 Background="#0D1117"
                                 BorderBrush="#1E2D3D"
                                 BorderThickness="1"
                                 Padding="8"
                                 x:Name="LogTextBox"
                                 TextChanged="LogTextBox_TextChanged" />
                    </StackPanel>
                </Border>

                <!-- ===== FOOTER ===== -->
                <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Run Text="Powered by " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                    <Hyperlink NavigateUri="https://github.com/CluvexStudio/Aether" 
                               RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="{StaticResource PrimaryBrush}" FontSize="11">
                        Aether Core
                    </Hyperlink>
                </TextBlock>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
